RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- WhatsApp (Meta Cloud API) ---
# From Meta for Developers > your app > WhatsApp > API Setup.
# See docs/whatsapp-integration.md for step-by-step setup.
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890123456
WHATSAPP_API_VERSION=v20.0
# Optional: name of an approved message template (needed for proactive
# messages outside a 24h customer session). Leave blank to send free-form
# text instead (only deliverable inside an open session window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
